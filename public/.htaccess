Options -Indexes
AddDefaultCharset utf-8
AddType text/javascript .js .mjs
AddType audio/ogg .ogg
AddType font/woff2 .woff2
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always merge Vary "User-Agent"
  Header set Cache-Control "no-cache" "expr=%{REQUEST_STATUS} == 200"
  Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_STATUS} == 200 && %{REQUEST_URI} =~ m#^/assets/#"
  Header always set Cache-Control "no-store" "expr=%{REQUEST_STATUS} == 403"
</IfModule>
